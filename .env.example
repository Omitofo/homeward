# Copy to .env.local. NEVER commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Phase 3+). The anon key is public by design; safety comes from RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required to promote shelter accounts (role is not client-writable).
# Supabase → Project Settings → API → service_role (secret).
# Never expose to the client, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags
# true = mock repositories for feed; auth still uses real Supabase when keys are set.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Optional error monitoring (P7-05). See docs/12-DEPLOY.md
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# ERROR_WEBHOOK_URL=
